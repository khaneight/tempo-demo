# --- Database (local docker-compose default) ---
DATABASE_URL=postgres://acme:acme@localhost:5434/acmeusd

# --- Tempo testnet (Moderato) ---
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
# ACME issuer = treasury. secp256k1 private key holding DEFAULT_ADMIN_ROLE + ISSUER_ROLE on AcmeUSD.
ISSUER_PRIVATE_KEY=0x...
# Output of `pnpm setup:token`
ACME_USD_ADDRESS=0x20c0...
TOKEN_DEPLOY_BLOCK=0
# Token the issuer pays its own fees in (pathUSD; faucet-funded)
ISSUER_FEE_TOKEN=0x20c0000000000000000000000000000000000000

# Same values exposed to the browser
NEXT_PUBLIC_ACME_USD_ADDRESS=0x20c0...
NEXT_PUBLIC_TREASURY_ADDRESS=0x...
NEXT_PUBLIC_EXPLORER_URL=https://explore.testnet.tempo.xyz

# --- Passkeys (WebAuthn relying party) ---
# Optional. Defaults: localhost locally; on Vercel, the deployment's own URL
# (production domain in production, the preview URL in previews). Set explicitly for a custom domain.
RP_ID=localhost
ORIGIN=http://localhost:3000

# --- Admin / secrets ---
ADMIN_PASSWORD=change-me
AUTH_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me

# --- Test-only fault injection (leave unset) ---
# CHAOS=mint_unknown | mint_revert | burn_unknown
